{
  "name": "obsidian-loose-json",
  "version": "0.2.3",
  "description": "Offline loose JSON formatting, log extraction and data conversion for Obsidian.",
  "private": true,
  "license": "MIT",
  "author": "Cynthia Ding",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "json5": "2.2.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.39.1",
    "@eslint/json": "0.14.0",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "30.1.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {"moment": "2.31.0"},
  "engines": {
    "node": ">=22"
  }
}
